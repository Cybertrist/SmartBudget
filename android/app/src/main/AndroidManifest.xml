<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BiometricPrompt, pour l'écran d'ouverture. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- La banque, et elle seule : Enable Banking, pour lire le compte. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Une seule notification : le compte courant passé en négatif. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/extraction"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Le retour de la banque : la page de redirection renvoie ici
                 le code d'autorisation, smartbudget://banque?code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="${schemaBanque}" android:host="banque"/>
            </intent-filter>
        </activity>
        <!-- Les widgets de l'écran d'accueil : une image dessinée par l'application
             (lib/ecran_accueil). -->
        <receiver
            android:name=".WidgetBudget"
            android:exported="true"
            android:label="@string/widget_budget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_budget_info" />
        </receiver>
        <receiver
            android:name=".WidgetEpargne"
            android:exported="true"
            android:label="@string/widget_epargne">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_epargne_info" />
        </receiver>
        <receiver
            android:name=".WidgetComptes"
            android:exported="true"
            android:label="@string/widget_comptes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_comptes_info" />
        </receiver>
        <receiver
            android:name=".WidgetAnalyse"
            android:exported="true"
            android:label="@string/widget_analyse">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analyse_info" />
        </receiver>
        <receiver
            android:name=".WidgetDepenses"
            android:exported="true"
            android:label="@string/widget_depenses">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_depenses_info" />
        </receiver>
        <receiver
            android:name=".WidgetAVenir"
            android:exported="true"
            android:label="@string/widget_avenir">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_avenir_info" />
        </receiver>
        <receiver
            android:name=".WidgetEspeces"
            android:exported="true"
            android:label="@string/widget_especes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_especes_info" />
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
