<?xml version="1.0" encoding="utf-8"?>
<!-- Le démarrage, avant Android 12 : le fond de l'application et le logo
     au centre, le temps que Flutter dessine son premier écran. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fond" />
    <item android:width="144dp" android:height="144dp" android:gravity="center">
        <bitmap android:gravity="fill" android:src="@drawable/logo_demarrage" />
    </item>
</layer-list>
